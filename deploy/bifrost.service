[Unit]
Description=Bifrost — view-only control tower for the dev box
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=you
Group=you
WorkingDirectory=/home/you/bifrost
ExecStart=/home/you/.npm-global/bin/bun server/index.ts
Restart=always
RestartSec=5
MemoryMax=300M

[Install]
WantedBy=multi-user.target
