{
  "bind": { "host": "127.0.0.1", "port": 4444 },
  "realms": [
    { "name": "projects", "path": "~/projects" },
    { "name": "work", "path": "~/work" }
  ],
  "claudeDir": "~/.claude",
  "claudeBin": "~/.local/bin/claude",
  "alerts": {
    "watchedUnits": ["ssh", "tailscaled"],
    "limitsUnit": null,
    "vapidSubject": "mailto:you@example.com"
  },
  "lifecycle": { "enabled": false, "idleParkMs": 86400000, "maxKillsPerSweep": 2 },
  "refresh": { "fastMs": 3000, "slowMs": 30000 },
  "sessions": { "historyDays": 14, "maxHistory": 60 },
  "summarize": {
    "claudeBin": "~/.local/bin/claude",
    "model": "sonnet",
    "effort": "low",
    "fastStartArgs": ["--strict-mcp-config"],
    "scratchDir": "~/.cache/bifrost/bg",
    "cacheDir": "~/.cache/bifrost/summaries",
    "perJobMb": 250,
    "ramShare": 0.33,
    "memReservePct": 0.15,
    "maxInFlightCap": 4,
    "maxQueue": 40,
    "timeoutMs": 120000
  },
  "auth": {
    "origins": ["http://127.0.0.1:4444", "https://your-host.your-tailnet.ts.net:8444"],
    "hosts": ["127.0.0.1:4444", "your-host.your-tailnet.ts.net:8444"],
    "enrollUrl": "https://your-host.your-tailnet.ts.net:8444"
  }
}
