{
  "bind": { "host": "100.100.100.100", "port": 4444 },
  "realms": [
    { "name": "projects", "path": "~/projects" },
    { "name": "work", "path": "~/work" }
  ],
  "claudeDir": "~/.claude",
  "refresh": { "fastMs": 3000, "slowMs": 30000 },
  "sessions": { "historyDays": 14, "maxHistory": 60 },
  "summarize": {
    "claudeBin": "/home/you/.local/bin/claude",
    "model": "haiku",
    "scratchDir": "~/.cache/atrium/bg",
    "cacheDir": "~/.cache/atrium/summaries",
    "maxInFlight": 2,
    "timeoutMs": 120000
  }
}
